{
  "name": "rigbyfy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "validate": "bun run lint && bun run check && bun run test && bun run build",
    "validate:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "prepare": "lefthook install",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@tsconfig/svelte": "^5.0.5",
    "eslint": "^9.34.0",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.3.0",
    "lefthook": "^2.1.9",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4",
    "vite": "^7.1.3"
  }
}
