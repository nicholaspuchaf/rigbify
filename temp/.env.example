# Copie para .env e preencha localmente. Nunca versionar o arquivo .env real.
# A ferramenta tenta YOUTUBE_API_KEY, depois YOUTUBE_API_KEY1, KEY2 e assim por diante
# quando a YouTube Data API reporta quota esgotada. Também aceita YOUTUBE_API_KEYS
# como uma lista separada por vírgulas.
YOUTUBE_API_KEY=
YOUTUBE_API_KEY1=
YOUTUBE_API_KEY2=
